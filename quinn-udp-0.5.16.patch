+/// Reads the upper 6 DSCP bits (masked with `0xfc`) from an existing socket's
+/// `IP_TOS` or `IPV6_TCLASS` option. Returns `None` if the socket option is
+/// unsupported or cannot be read.
+fn get_dscp_option(
+    socket: &impl AsRawFd,
+    level: libc::c_int,
+    name: libc::c_int,
+) -> Option<u8> {
+    let mut val: libc::c_int = 0;
+    let mut len = mem::size_of_val(&val) as libc::socklen_t;
+    let rc = unsafe {
+        libc::getsockopt(
+            socket.as_raw_fd(),
+            level,
+            name,
+            &mut val as *mut _ as *mut libc::c_void,
+            &mut len,
+        )
+    };
+    if rc != 0 {
+        return None;
+    }
+    let byte = if len as usize == mem::size_of::<u8>() {
+        unsafe { *(&val as *const libc::c_int as *const u8) }
+    } else if len as usize >= mem::size_of::<libc::c_int>() {
+        val as u8
+    } else {
+        return None;
+    };
+    Some(byte & 0xfc)
+}
+
 const OPTION_ON: libc::c_int = 1;
 
