[Unit]
Description=SOCKS5/TUN to Outline proxy client (outline-client)
Documentation=https://github.com/balookrd/outline-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RUST_LOG=info
Environment=NO_COLOR=1
# 512 KiB of stack per tokio worker/blocking thread instead of the 2 MiB
# default — async tasks live on the heap, so worker stacks stay shallow. Saves
# a few committed MiB on low-core devices; raise it back if a native resolver
# or deep FFI ever overflows (the binary would crash on start, not corrupt).
Environment=THREAD_STACK_SIZE_KB=512
# Persist active-uplink selection to the writable state directory.
# The default path (same dir as config, .state.toml extension) would land in
# /etc/ which is read-only under ProtectSystem=strict + DynamicUser.
Environment=STATE_PATH=/var/lib/outline-client/_default/state.toml
ExecStart=/usr/local/bin/outline-client --config /etc/outline-client/config.toml
Restart=on-failure
RestartSec=3s

# If OUTLINE_FWMARK is configured, keep CAP_NET_ADMIN. Otherwise these two
# lines can be removed.
#
# fwmark (OUTLINE_FWMARK / direct_fwmark) ALSO requires `PrivateUsers=no`:
# setsockopt(SO_MARK) is authorized against the user namespace that OWNS the
# network stack (the init ns), and under PrivateUsers=true the service holds
# CAP_NET_ADMIN only inside its private userns — so every SO_MARK fails EPERM
# and every direct dial dies instantly while non-fwmark dials keep working
# (observed 2026-07-19: all TUN direct traffic down on a host that enabled
# direct_fwmark, uplink dials unaffected). Override via a drop-in:
#   [Service]
#   PrivateUsers=no
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Reasonable production limits.
LimitNOFILE=1048576
LimitSTACK=8M
TasksMax=infinity
NoNewPrivileges=true

# Memory guardrails. On low-RAM hosts (e.g. 1 GiB SBCs) a sudden burst of flows
# can exhaust RAM faster than the kernel reclaims it, livelocking the whole host
# (no OOM-killer entry — just a hang until a manual power-cycle). Bounding the
# service makes the kernel OOM-kill and restart *it* (Restart=on-failure above),
# leaving the host alive. Percentages scale across hosts of different RAM sizes:
# MemoryMax (hard OOM-kill) leaves the OS ~15% headroom; MemoryHigh throttles and
# reclaims anonymous pages to swap (zram recommended) before the hard kill. For a
# fixed limit on a specific host, override with a drop-in (…/service.d/*.conf).
MemoryAccounting=yes
MemoryHigh=70%
MemoryMax=85%

User=outline-client
Group=outline-client
StateDirectory=outline-client/_default
LogsDirectory=outline-client/_default
RuntimeDirectory=outline-client
WorkingDirectory=/var/lib/outline-client/_default
UMask=0077

PrivateTmp=true
# TUN support needs access to /dev/net/tun on the host.
PrivateDevices=false
PrivateUsers=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

# /etc/outline-client is writable so dashboard CRUD endpoints and the
# on-load config migrator (legacy top-level keys → [outline]) can persist
# changes. The directory must be owned by outline-client:outline-client —
# install.sh sets this up; for manual installs, `chown -R
# outline-client:outline-client /etc/outline-client && chmod 0750
# /etc/outline-client`.
ReadWritePaths=/var/lib/outline-client/_default /var/log/outline-client/_default /etc/outline-client

[Install]
WantedBy=multi-user.target
