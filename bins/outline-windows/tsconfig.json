{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleResolution": "bundler"
  },
  "include": ["frontend/src/**/*.d.ts", "frontend/src/**/*.ts", "frontend/src/**/*.js", "frontend/src/**/*.svelte"]
}
