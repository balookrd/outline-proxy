+    if send_poisoned {
+        H3ShutdownPhase::Finish
+    } else if write_queued {
+        H3ShutdownPhase::DrainPendingWrite
+    } else if !shutdown_started {
+        H3ShutdownPhase::Grease
+    } else {
+        H3ShutdownPhase::Finish
+    }
+}
