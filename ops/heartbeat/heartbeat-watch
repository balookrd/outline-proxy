#!/usr/bin/env python3
#
# heartbeat-watch — tell the owner when the home dead man's switch stops
# reporting. Runs on cloud1/cloud2 from a systemd timer; deliberately uses
# nothing but the standard library (plus the system curl for Telegram), because
# the whole point of this watcher is to keep working when the monitoring it
# watches is gone.
#
# Two channels: mail through Gmail SMTP, always; Telegram when
# /etc/heartbeat-watch/telegram.env is present. api.telegram.org is blocked from
# these hosts, so Telegram goes through the local outline-ws-rust SOCKS5 — if
# that tunnel is down at the same time, mail still gets through.

import argparse
import email.message
import json
import os
import re
import smtplib
import socket
import ssl
import subprocess
import sys
import time
from datetime import datetime

# nginx combined log: 1.2.3.4 - - [07/Aug/2026:12:00:00 +0300] "POST ..." 204 0
TS_RE = re.compile(r"\[([^\]]+)\]")
TS_FMT = "%d/%b/%Y:%H:%M:%S %z"


def last_heartbeat(log_path):
    """Epoch seconds of the most recent heartbeat, or None if there was never one.

    Reads the rotated file as well: logrotate runs nightly, and for the minutes
    between the rotation and the next heartbeat the live log is empty. Judging
    by the live file alone would report an outage every night.
    """
    for path in (log_path, log_path + ".1"):
        try:
            with open(path, "rb") as fh:
                lines = [ln for ln in fh.read().splitlines() if ln.strip()]
        except FileNotFoundError:
            continue
        if not lines:
            continue
        match = TS_RE.search(lines[-1].decode("utf-8", "replace"))
        if not match:
            continue
        try:
            return int(datetime.strptime(match.group(1), TS_FMT).timestamp())
        except ValueError:
            continue
    return None


def load_state(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (FileNotFoundError, ValueError):
        return {"state": "up", "notified_at": 0}


def save_state(path, state):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh)
    os.replace(tmp, path)


def compose(kind, age, now):
    """Subject and body shared by every channel."""
    observer = socket.gethostname()
    stamp = time.strftime("%Y-%m-%d %H:%M:%S %Z", time.localtime(now))
    if kind == "DOWN":
        subject = f"[{observer}] outline: no heartbeat from home monitoring"
        body = (
            f"No heartbeat from the dead man's switch of the home monitoring (k3s).\n\n"
            f"Observer:       {observer}\n"
            f"Last heartbeat: {'never' if age is None else str(int(age)) + ' seconds ago'}\n"
            f"Checked at:     {stamp}\n\n"
            f"A message from only one observer usually means the path to that observer\n"
            f"is broken. Messages from both cloud1 and cloud2 mean the home monitoring\n"
            f"(VictoriaMetrics, alerting, or the home link) is down.\n"
        )
    elif kind == "TEST":
        subject = f"[{observer}] outline: heartbeat-watch test message"
        body = f"Delivery test, nothing is wrong.\n\nObserver: {observer}\nAt:       {stamp}\n"
    else:
        subject = f"[{observer}] outline: heartbeat from home monitoring resumed"
        body = f"Heartbeat resumed.\n\nObserver: {observer}\nAt:       {stamp}\n"
    return subject, body


def send_mail(kind, age, now):
    """Send through the same Gmail account the home alerting uses. Raises on failure."""
    host = os.environ["SMTP_HOST"]
    user = os.environ["SMTP_USER"]
    password = os.environ["SMTP_PASSWORD"]
    to = os.environ["MAIL_TO"]
    subject, body = compose(kind, age, now)

    msg = email.message.EmailMessage()
    msg["From"] = user
    msg["To"] = to
    msg["Subject"] = subject
    msg.set_content(body)

    hostname, _, port = host.partition(":")
    with smtplib.SMTP(hostname, int(port or 587), timeout=30) as smtp:
        smtp.starttls(context=ssl.create_default_context())
        smtp.login(user, password)
        smtp.send_message(msg)


def _curl_quote(value):
    """A double-quoted curl config value: backslash, quote and newline escaped."""
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{escaped}"'


def telegram_curl_config(kind, age, now):
    """curl config for one sendMessage call. Fed on stdin (curl -K -), so the
    bot token and the proxy password never appear in argv or `ps`."""
    token = os.environ["TELEGRAM_BOT_TOKEN"]
    subject, body = compose(kind, age, now)
    lines = [
        "silent",
        "show-error",
        "fail",
        "max-time = 30",
        'output = "/dev/null"',
        f"url = {_curl_quote(f'https://api.telegram.org/bot{token}/sendMessage')}",
        f"data-urlencode = {_curl_quote('chat_id=' + os.environ['TELEGRAM_CHAT_ID'])}",
        f"data-urlencode = {_curl_quote('text=' + subject + chr(10) + chr(10) + body)}",
    ]
    proxy = os.environ.get("TELEGRAM_PROXY")
    if proxy:
        # socks5h: the proxy resolves api.telegram.org, local DNS never sees it.
        lines.append(f"proxy = {_curl_quote(proxy)}")
        if os.environ.get("TELEGRAM_PROXY_USER"):
            lines.append(f"proxy-user = {_curl_quote(os.environ['TELEGRAM_PROXY_USER'])}")
    return "\n".join(lines) + "\n"


def send_telegram(kind, age, now):
    """Plain-text message through the Bot API. Raises on failure."""
    curl = os.environ.get("HEARTBEAT_CURL", "curl")
    result = subprocess.run(
        [curl, "-K", "-"],
        input=telegram_curl_config(kind, age, now),
        capture_output=True,
        text=True,
        timeout=45,
    )
    if result.returncode != 0:
        raise RuntimeError(f"curl exit {result.returncode}: {result.stderr.strip()[:200]}")


def channels():
    """Delivery channels configured on this host: mail always, Telegram when set up."""
    found = [("mail", send_mail)]
    if os.environ.get("TELEGRAM_BOT_TOKEN"):
        found.append(("telegram", send_telegram))
    return found


def deliver(chans, kind, age, now):
    """Try every channel; one failing must not cost the others their message.
    Returns (delivered count, [(channel, error), ...])."""
    sent, errors = 0, []
    for name, send in chans:
        try:
            send(kind, age, now)
            sent += 1
        except Exception as exc:  # any failure of one channel is reported, not fatal
            errors.append((name, exc))
    return sent, errors


def main():
    ap = argparse.ArgumentParser(description="alert when the heartbeat stops")
    ap.add_argument("--log", default="/var/log/nginx/heartbeat.log")
    ap.add_argument("--state", default="/var/lib/heartbeat-watch/state.json")
    ap.add_argument("--threshold", type=int, default=900)
    ap.add_argument("--repeat", type=int, default=21600)
    ap.add_argument("--now", type=int, default=None)
    # --dry-run is for humans: it must not touch the state file. A diagnostic
    # run that records "already notified" would silence the next real outage.
    ap.add_argument("--dry-run", action="store_true", help="print the decision, change nothing")
    # --simulate is for the tests: same printing, but state advances, so a
    # sequence of runs exercises the real transitions without sending mail.
    ap.add_argument("--simulate", action="store_true", help="like --dry-run but persist state")
    # --test sends a clearly labelled message through every configured channel
    # and touches no state: the way to check delivery after an install.
    ap.add_argument("--test", action="store_true", help="send a test message to every channel")
    args = ap.parse_args()

    now = args.now if args.now is not None else int(time.time())
    if args.test:
        sent, errors = deliver(channels(), "TEST", None, now)
        for name, exc in errors:
            print(f"{name}: {exc}", file=sys.stderr)
        print(f"test: delivered to {sent} of {sent + len(errors)} channel(s)")
        return 1 if errors else 0
    last = last_heartbeat(args.log)
    state = load_state(args.state)

    # No log at all means the receiver has never been hit — a fresh install,
    # not an outage. Staying quiet here is what keeps the first deploy silent.
    down = last is not None and (now - last) > args.threshold
    age = None if last is None else now - last

    send = None
    if down and state["state"] != "down":
        send = "DOWN"
    elif down and (now - state.get("notified_at", 0)) >= args.repeat:
        send = "DOWN"
    elif not down and state["state"] == "down":
        send = "RESOLVED"

    if args.dry_run or args.simulate:
        label = "down" if down else "up"
        suffix = f" send={send or 'none'}" if (down or send) else ""
        print(f"state={label}{suffix}")
    failed = False
    if send and not (args.dry_run or args.simulate):
        sent, errors = deliver(channels(), send, age, now)
        for name, exc in errors:
            print(f"{name}: {exc}", file=sys.stderr)
        failed = bool(errors)
        # Nothing got out: keep the old state so the next run (5 min) retries,
        # as it did when mail was the only channel. If at least one channel
        # delivered, record the notification — retrying would spam that channel.
        if sent == 0:
            return 1

    if args.dry_run:
        return 0

    if send == "DOWN":
        state = {"state": "down", "notified_at": now}
    elif down:
        state["state"] = "down"
    else:
        state = {"state": "up", "notified_at": 0}
    save_state(args.state, state)
    # A partly failed delivery still exits non-zero, so the unit shows failed
    # and the journal keeps the error.
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
