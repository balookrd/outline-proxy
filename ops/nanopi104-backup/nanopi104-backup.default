# /etc/default/nanopi104-backup — environment for nanopi104-backup.service.
# Edit these, then: systemctl restart nanopi104-backup.timer

# --- REQUIRED: point these at your NFS export --------------------------------
NFS_HOST=CHANGE-ME.nfs.host
NFS_EXPORT=/export/nanopi-backups

# --- Optional tuning ---------------------------------------------------------
# NFS_OPTS=vers=4,soft,timeo=50,retrans=3,noatime,nolock
# NFS_SUBDIR=nanopi104
# KEEP=6                 # how many images to retain
# MODE=e2image           # e2image (used blocks, portable restore) | dd (raw)
# STOP_SERVICES=0        # 1 = stop outline-ws-rust during the snapshot
