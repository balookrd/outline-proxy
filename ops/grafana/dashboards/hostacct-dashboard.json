    {
      "type": "stat",
      "id": 3,
      "title": "Coverage: hosts / gre1 tx",
      "description": "Sum of per-host down counters divided by gre1 tx bytes. Near 100% under real load. Packets the node itself sends into gre1 (VRF processes resolving via 198.18.1.1, tunnel keepalives) are not forwarded and not counted, so with almost no traffic the ratio sits lower. A drop under load means the nftables table was flushed or the 512-element set is full.",
      "datasource": {
        "type": "prometheus",
        "uid": "adnsc1wi03doga"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50000000.0
              },
              {
                "color": "red",
                "value": 100000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (increase(hostacct_bytes_total{instance=~\"$node\", dir=\"down\"}[15m])) / sum by (instance) (increase(node_network_transmit_bytes_total{instance=~\"$node\", device=\"gre1\"}[15m]))",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true
        }
      ]
    },
