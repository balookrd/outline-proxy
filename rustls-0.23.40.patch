+/// A uniformly random index below `n` (`n >= 1`), by rejection sampling
+/// (client-hello-shape patch).
+fn pick_index(secure_random: &dyn SecureRandom, n: usize) -> Result<usize, Error> {
+    let n = n as u32;
+    let zone = u32::MAX - u32::MAX % n;
+    loop {
+        let v = crate::rand::random_u32(secure_random)?;
+        if v < zone {
+            return Ok((v % n) as usize);
+        }
+    }
+}
