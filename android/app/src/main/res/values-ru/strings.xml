    <!-- Keep-Alive screen: background-survival permissions checklist. -->
    <string name="ka_persistent_notif">Постоянное уведомление</string>
    <string name="ka_persistent_notif_desc">Держать в шторке уведомление с кнопкой подключения/отключения, даже когда VPN выключен.</string>
    <string name="ka_qs_tile">Плитка быстрых настроек</string>
    <string name="ka_qs_tile_desc">Переключать туннель прямо из панели быстрых настроек.</string>
    <string name="ka_add_tile">Добавить плитку</string>
    <string name="ka_add_tile_hint">Откройте быстрые настройки, нажмите «изменить» (карандаш) и добавьте плитку Outline.</string>
    <string name="ka_intro">Android и производитель телефона могут останавливать фоновые приложения. Эти переключатели помогают поддерживать туннель.</string>
    <string name="ka_always_on">Постоянная VPN</string>
    <string name="ka_always_on_desc">Самый надёжный вариант: система сама поддерживает туннель и перезапускает его. Включите «Постоянная VPN» для Outline Proxy в списке VPN.</string>
    <string name="ka_open_vpn_settings">Открыть настройки VPN</string>
    <string name="ka_ignore_batt">Игнорировать оптимизацию батареи</string>
    <string name="ka_ignore_batt_desc">Без этого Android может останавливать туннель в фоне и не давать приложению поднять его заново.</string>
    <string name="ka_exact_alarms">Пробуждение в фоне</string>
    <string name="ka_exact_alarms_desc">Приложение само просыпается раз в несколько минут, проверяет туннель и поднимает его, если связь пропала. Без этого разрешения Android откладывает проверки, пока телефон спит, — и туннель может остаться выключенным до разблокировки. В настройках Android оно называется «Будильники и напоминания».</string>
    <string name="ka_notifications">Уведомления</string>
    <string name="ka_notifications_desc">Туннель работает как foreground-сервис. Скрытое уведомление повышает риск того, что некоторые прошивки его завершат.</string>
    <string name="ka_network_type">Тип сети</string>
    <string name="ka_network_type_desc">Необязательно. Позволяет главному экрану точно называть поколение мобильной сети (2G/3G/LTE/5G), а не угадывать класс по оценке скорости. На решения туннеля это не влияет — тайм-ауты подключения в любом случае рассчитываются по оценке скорости.</string>
    <!-- Keep-Alive: карточка вендорского автозапуска. -->
    <string name="ka_vendor_autostart">Автозапуск: %1$s</string>
    <string name="ka_vendor_autostart_desc">%1$s ведёт свой список приложений, которым разрешён запуск в фоне, — отдельно от списка Android. Прочитать его нельзя, поэтому откройте «%2$s» и разрешите там работу Outline Proxy.</string>
    <string name="ka_vendor_autostart_desc_huawei">%1$s по умолчанию управляет фоновыми приложениями сам. На экране настроек выключите «Автоматическое управление» для Outline Proxy, затем включите «Автозапуск», «Косвенный запуск» и «Работа в фоновом режиме».</string>
    <string name="ka_toggle_autostart">Автозапуск</string>
    <string name="ka_toggle_allow_autostart">Автозапуск</string>
    <string name="ka_toggle_autostart_manager">Менеджер автозапуска</string>
    <string name="ka_toggle_run_in_background">Работа в фоновом режиме</string>
    <string name="ka_toggle_autostart_management">Управление автозапуском</string>
    <string name="ka_toggle_background_autostart">Автозапуск в фоновом режиме</string>
    <string name="ka_toggle_autostarts">Auto-starts</string>
    <!-- Keep-Alive: карточка вендорской политики батареи. -->
    <string name="ka_vendor_battery">Батарея: %1$s</string>
    <string name="ka_vendor_battery_desc">У %1$s есть своя политика батареи для каждого приложения — поверх системной. Откройте её и снимите ограничения для Outline Proxy.</string>
    <string name="ka_vendor_battery_desc_xiaomi">У %1$s своя политика батареи, отдельная от системной. В открывшемся окне выберите для Outline Proxy «Нет ограничений» — или найдите пункт «Контроль активности» на странице приложения.</string>
    <string name="ka_vendor_battery_desc_samsung">%1$s усыпляет неиспользуемые приложения. В открывшемся списке нажмите «+» и добавьте Outline Proxy. Если он не открылся, найдите его в настройках: «Батарея» → «Ограничения в фоновом режиме» → «Не уходят в сон автоматически» (до One UI 6.1 — «Неспящие приложения»).</string>
    <string name="ka_open_vendor_settings">Открыть настройки %1$s</string>
    <string name="ka_status_allowed">Разрешено</string>
    <string name="ka_status_needs_action">Требуется действие</string>
    <string name="ka_status_check_manually">Проверьте вручную</string>
    <string name="btn_allow">Разрешить</string>

