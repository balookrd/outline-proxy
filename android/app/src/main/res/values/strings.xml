    <!-- Keep-Alive screen: background-survival permissions checklist. -->
    <string name="ka_persistent_notif">Persistent notification</string>
    <string name="ka_persistent_notif_desc">Keep a notification with a Connect/Disconnect button in the status bar, even when the VPN is off.</string>
    <string name="ka_qs_tile">Quick Settings tile</string>
    <string name="ka_qs_tile_desc">Toggle the tunnel straight from the Quick Settings panel.</string>
    <string name="ka_add_tile">Add tile</string>
    <string name="ka_add_tile_hint">Open Quick Settings, tap edit (pencil), and add the Outline tile.</string>
    <string name="ka_intro">Android and the phone vendor may stop background apps. These switches are what keeps the tunnel up.</string>
    <string name="ka_always_on">Always-on VPN</string>
    <string name="ka_always_on_desc">The strongest option: the system itself keeps the tunnel up and restarts it. Turn on \"Always-on VPN\" for Outline Proxy in the VPN list.</string>
    <string name="ka_open_vpn_settings">Open VPN settings</string>
    <string name="ka_ignore_batt">Ignore battery optimisation</string>
    <string name="ka_ignore_batt_desc">Without it Android may stop the tunnel in the background and refuse to let the watchdog restart it.</string>
    <string name="ka_exact_alarms">Exact alarms</string>
    <string name="ka_exact_alarms_desc">The watchdog checks the tunnel through Doze. Without this permission the checks are delayed by the system.</string>
    <string name="ka_notifications">Notifications</string>
    <string name="ka_notifications_desc">The tunnel runs as a foreground service. A hidden notification makes some firmware more eager to kill it.</string>
    <string name="ka_network_type">Network type</string>
    <string name="ka_network_type_desc">Optional. Lets the home screen name the radio technology (2G / 3G / LTE / 5G) instead of guessing a class from the speed estimate. Nothing the tunnel decides depends on it — the dial timeouts are sized from the speed estimate either way.</string>
    <string name="ka_vendor_autostart">%1$s autostart</string>
    <string name="ka_vendor_autostart_desc">%1$s keeps its own list of apps allowed to run in the background. There is no API to read it — open the screen and allow Outline Proxy there.</string>
    <string name="ka_open_vendor_settings">Open %1$s settings</string>
    <string name="ka_status_allowed">Allowed</string>
    <string name="ka_status_needs_action">Needs action</string>
    <string name="ka_status_check_manually">Check manually</string>
