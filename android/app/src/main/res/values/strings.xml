    <!-- Keep-Alive screen: background-survival permissions checklist. -->
    <string name="ka_persistent_notif">Persistent notification</string>
    <string name="ka_persistent_notif_desc">Keep a notification with a Connect/Disconnect button in the status bar, even when the VPN is off.</string>
    <string name="ka_qs_tile">Quick Settings tile</string>
    <string name="ka_qs_tile_desc">Toggle the tunnel straight from the Quick Settings panel.</string>
    <string name="ka_add_tile">Add tile</string>
    <string name="ka_add_tile_hint">Open Quick Settings, tap edit (pencil), and add the Outline tile.</string>
    <string name="ka_intro">Android and the phone vendor may stop background apps. These switches are what keeps the tunnel up.</string>
    <string name="ka_always_on">Always-on VPN</string>
    <string name="ka_always_on_desc">The strongest option: the system itself keeps the tunnel up and restarts it. Turn on \"Always-on VPN\" for Outline Proxy in the VPN list.</string>
    <string name="ka_open_vpn_settings">Open VPN settings</string>
    <string name="ka_ignore_batt">Ignore battery optimisation</string>
    <string name="ka_ignore_batt_desc">Without it Android may stop the tunnel in the background and refuse to let the app bring it back.</string>
    <!-- Named for what it does rather than for the API (SCHEDULE_EXACT_ALARM): "exact
         alarms" reads like a clock app. The system screen's own name is in the body
         so the button does not land somewhere unexpected. -->
    <string name="ka_exact_alarms">Background wake-ups</string>
    <string name="ka_exact_alarms_desc">The app wakes itself every few minutes to check the tunnel and bring it back if the link died. Without this permission Android defers those checks while the phone sleeps, so the tunnel can stay down until you unlock it. Android calls this permission \"Alarms &amp; reminders\".</string>
    <string name="ka_notifications">Notifications</string>
    <string name="ka_notifications_desc">The tunnel runs as a foreground service. A hidden notification makes some firmware more eager to kill it.</string>
    <string name="ka_network_type">Network type</string>
    <string name="ka_network_type_desc">Optional. Lets the home screen name the radio technology (2G / 3G / LTE / 5G) instead of guessing a class from the speed estimate. Nothing the tunnel decides depends on it — the dial timeouts are sized from the speed estimate either way.</string>
    <!-- Keep-Alive: vendor autostart card. The quoted names are what the user sees
         in the vendor's own UI, so they follow that UI's wording per language
         rather than being translated literally. -->
    <string name="ka_vendor_autostart">%1$s autostart</string>
    <!-- "%2$s" is a toggle on some skins and a whole screen on others (Asus, Tecno),
         so the wording has to fit both: open it, then allow the app there. -->
    <string name="ka_vendor_autostart_desc">%1$s keeps its own list of apps allowed to start in the background, separate from Android\'s. There is no API to read it — open \"%2$s\" and allow Outline Proxy there.</string>
    <string name="ka_vendor_autostart_desc_huawei">%1$s manages background apps itself by default. On the settings screen, turn \"Manage automatically\" off for Outline Proxy, then turn on \"Auto-launch\", \"Secondary launch\" and \"Run in background\".</string>
    <string name="ka_toggle_autostart">Autostart</string>
    <string name="ka_toggle_allow_autostart">Auto launch</string>
    <string name="ka_toggle_autostart_manager">Auto-start Manager</string>
    <string name="ka_toggle_run_in_background">Run in background</string>
    <string name="ka_toggle_autostart_management">App Launch</string>
    <string name="ka_toggle_background_autostart">Background autostart</string>
    <!-- Meizu ships no Russian for this label, so the RU value is the English the user actually sees. -->
    <string name="ka_toggle_autostarts">Auto-starts</string>
    <!-- Keep-Alive: vendor battery-policy card, separate from Android's Doze list. -->
    <string name="ka_vendor_battery">%1$s battery policy</string>
    <string name="ka_vendor_battery_desc">%1$s applies its own per-app battery policy on top of Android\'s. Open it and give Outline Proxy the unrestricted option.</string>
    <string name="ka_vendor_battery_desc_xiaomi">%1$s keeps its own battery policy, separate from Android\'s. In the window that opens, pick \"No restrictions\" for Outline Proxy — or find it under \"App battery saver\" on the app page.</string>
    <!-- The button deep-links straight into the allowlist (verified on One UI 8), so
         the copy starts from there; the manual path is the fallback for builds where
         the deeplink is missing. "Never sleeping apps" was its name before One UI 6.1. -->
    <string name="ka_vendor_battery_desc_samsung">%1$s puts unused apps to sleep. In the list that opens, tap \"+\" and add Outline Proxy. If it does not open, find it under Battery → \"Background usage limits\" → \"Never auto sleeping apps\" (\"Never sleeping apps\" before One UI 6.1).</string>
    <string name="ka_open_vendor_settings">Open %1$s settings</string>
