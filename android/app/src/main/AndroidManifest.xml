<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to enumerate installed apps for the split-tunnel picker. VPN is
         an allowed use case for this permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Needed to watch the underlying network so the tunnel can follow
         Wi-Fi <-> cellular handovers (setUnderlyingNetworks). Without it
         registering a NetworkCallback throws SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed to read the connected Wi-Fi network's SSID for Wi-Fi automation rules. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep-alive: an exact alarm pierces Doze and is one of the exemptions
         that make starting a foreground service from the background legal; boot
         restores the tunnel; battery-optimisation exemption is requested from
         the keep-alive screen. Deliberately no USE_EXACT_ALARM next to it: that
         one is meant for alarm clocks and calendars, and alongside a VpnService,
         QUERY_ALL_PACKAGES and boot-persistence it completes the profile Play
         Protect scores as stalkerware, which is what gets sideloaded builds
         flagged. SCHEDULE_EXACT_ALARM is not granted on install for targetSdk 34+
         either, so the keep-alive checklist asks for it; until it is given,
         WatchdogAlarm runs on an inexact alarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, and never requested on its own: it only names the radio
         technology (LTE / 5G / 2G) on the home screen. Everything the tunnel
         itself decides — the carrier-dial budget above all — is derived from the
         bandwidth estimate in NetworkCapabilities, which needs no permission, so
         denying this costs a label and nothing else. The keep-alive checklist
         offers it alongside the other grants. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Outline Proxy"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- External control over `outline://connect|disconnect|toggle`, for
             automation apps and shortcuts. Invisible (translucent theme) and
             kept out of the recents list; it finishes as soon as the command is
             dispatched. Anyone can send the intent, so the commands are gated
             in-app by the External control switch and optional token
             (see ExternalControl.kt). No `noHistory` here: it would kill the
             activity while the system VPN consent dialog is up and the result
             would never come back. -->
        <activity
            android:name=".ControlActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- BROWSABLE lets links, QR codes and launcher shortcuts fire
                     the scheme; it also lets a web page try, hence the token. -->
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="outline" />
            </intent-filter>
        </activity>

        <!-- The persistent notification's Connect action. Invisible (translucent)
             and exported="false" so only our own notification drives it; external
             callers still go through the gated outline:// ControlActivity. No
             intent-filter, kept out of recents. -->
        <activity
            android:name=".QuickConnectActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The VPN tunnel service. BIND_VPN_SERVICE is granted to the system
             only; the special-use foreground type keeps the tunnel alive. -->
        <service
            android:name=".OutlineVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_tunnel" />
        </service>

        <!-- Quick Settings tile: a connect/disconnect toggle in the QS panel,
             mirroring the notification's toggle. exported + BIND_QUICK_SETTINGS_TILE
             so only the system can bind it; the user adds it from the QS editor. -->
        <service
            android:name=".OutlineTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_tunnel"
            android:label="Outline"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Exact-alarm watchdog: fires through Doze and is re-armed by ensure(). -->
        <receiver
            android:name=".keepalive.WatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Comes back after a reboot and after the app itself is updated. -->
        <receiver
            android:name=".keepalive.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
